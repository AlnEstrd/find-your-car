# --- CodeMie LLM (OpenAI-compatible endpoint) ---
# Get the base URL and an API key from your CodeMie workspace (LLM proxy / integrations).
# Leave empty to run in offline demo mode (rule-based parser, no LLM).
CODEMIE_API_URL=
CODEMIE_API_KEY=
CODEMIE_MODEL=gpt-4o

# --- Optional channels ---
# Create a bot with @BotFather and paste its token to chat via Telegram too.
TELEGRAM_BOT_TOKEN=

# --- Server ---
PORT=3000
# If set, the agent console API requires ?token=<ADMIN_TOKEN> (open /agent.html?token=...)
ADMIN_TOKEN=
